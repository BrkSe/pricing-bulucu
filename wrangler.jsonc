{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pricing-bulucu",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "dev": {
    "ip": "0.0.0.0",
    "port": 43123
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    // "true" iken Workers AI çağrılmaz; planlar sayfa metninden çıkarılır.
    // Yerel deneme: npx wrangler dev --var MOCK_AI:true
    "MOCK_AI": "false",
    // Ücretsiz planda duran, kaldırılma tarihi olmayan metin modeli.
    // Başka bir modele geçmek için bu değeri değiştirip yeniden deploy edin.
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  }
}
